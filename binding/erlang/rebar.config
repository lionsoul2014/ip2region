{erl_opts, [
    debug_info,
    export_all,
    nowarn_export_all
]}.

%% The default checks without exports_not_used, which flags every public API
%% function and the benchmark entry point of this library.
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{plugins, [rebar3_hex, rebar3_ex_doc]}.

{project_plugins, [{erlfmt, "1.8.0"}]}.

{erlfmt, [
    write,
    {files, "{src,include,test}/*.{hrl,erl}"}
]}.

{deps, [
    poolboy
]}.

{shell, [
  % {config, "config/sys.config"},
    {apps, [ip2region]}
]}.

{ex_doc, [
    {extras, ["README.md"]},
    {main, "README.md"},
    {source_url, "https://github.com/lionsoul2014/ip2region/tree/master/binding/erlang"}
]}.

{hex, [{doc, ex_doc}]}.
